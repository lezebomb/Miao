{
  "formatVersion": 1,
  "globalDurationScale": 1.0,
  "windowScale": 1.0,
  "idlePauseRangeMs": [
    3000,
    6000
  ],
  "hoverDwellMs": 500,
  "triggerCooldownMs": 2000,
  "renderer": {
    "engine": "canvas",
    "targetFps": 60,
    "alphaCrossfade": false,
    "transformInterpolation": true,
    "edgeSmoothing": {
      "enabled": true,
      "blurPx": 0.7,
      "alpha": 0.24
    }
  },
  "idle": {
    "basicActionIntervalMs": [
      4000,
      8000
    ],
    "specialAfterMs": 30000,
    "sleepAfterMs": 180000
  },
  "drag": {
    "horizontalThresholdPx": 16,
    "horizontalDominanceRatio": 1.35
  },
  "codexWindow": {
    "placement": "outside-right-bottom",
    "offsetX": 16,
    "offsetY": -16,
    "edgePadding": 16,
    "followIntervalMs": 100,
    "waitTimeoutMs": 60000
  }
}
